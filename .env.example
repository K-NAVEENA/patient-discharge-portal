# Flask Secret Key
SECRET_KEY=change_this_to_a_strong_random_secret_key_in_production

# Database Configuration (MySQL is standard)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/patient_discharge_db

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=1
